<% layout('layouts/boilerplate') -%>

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-6">
            <div class="card p-4 shadow border-0">
                <h3 class="card-title text-center mb-4 text-dark fw-bold">
                    Edit Review
                </h3>
                <form
                    novalidate
                    action="/listings/<%= listingId %>/review/<%= review._id %>?_method=PUT"
                    method="POST"
                    class="needs-validation">
                    <input type="hidden" name="for" value="<%= listingId %>" />
                    <input
                        type="hidden"
                        name="avatar"
                        value="<%= review.avatar %>" />

                    <!-- Rating -->
                    <div class="mb-4">
                        <label
                            for="stars"
                            class="form-label fw-semibold text-secondary">
                            Rating
                        </label>

                        <input
                            type="range"
                            class="form-range"
                            min="1"
                            max="5"
                            id="stars"
                            name="stars"
                            step="0.5"
                            value="<%= review.stars %>"
                            required />

                        <div
                            class="d-flex justify-content-between text-muted small px-1 mt-1">
                            <span>1★</span>
                            <span>2★</span>
                            <span>3★</span>
                            <span>4★</span>
                            <span>5★</span>
                        </div>
                    </div>

                    <!-- Comments -->
                    <div class="mb-4">
                        <label
                            for="content"
                            class="form-label fw-semibold text-secondary">
                            Comments
                        </label>

                        <textarea
                            class="form-control"
                            id="content"
                            name="content"
                            rows="4"
                            minlength="10"
                            maxlength="200"
                            style="
                                height: 100px;
                                max-height: 300px;
                                min-height: 50px;
                            "
                            placeholder="Update your feedback here..."
                            required>
<%= review.content %></textarea
                        >

                        <div class="invalid-feedback">
                            Review must be between 10 and 200 characters.
                        </div>

                        <div class="valid-feedback">Nice! Review ✓</div>
                    </div>

                    <div class="d-flex gap-2">
                        <button
                            type="submit"
                            class="btn btn-dark flex-grow-1 shadow-sm py-2">
                            Save Changes
                        </button>

                        <a
                            href="/listings/<%= listingId %>"
                            class="btn btn-outline-secondary px-3 py-2">
                            Cancel
                        </a>
                    </div>
                </form>

                <script>
                    (() => {
                        "use strict";

                        const forms =
                            document.querySelectorAll(".needs-validation");

                        Array.from(forms).forEach((form) => {
                            form.addEventListener("submit", (event) => {
                                if (!form.checkValidity()) {
                                    event.preventDefault();
                                    event.stopPropagation();
                                }

                                form.classList.add("was-validated");
                            });
                        });
                    })();
                </script>
            </div>
        </div>
    </div>
</div>
