<% layout('layouts/boilerplate') -%>
<main class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

  <% allListings.forEach(listing => { %>

    <div class="col">
      <a href="/listings/<%= listing.id %>" class="text-decoration-none">

        <div class="card h-100">

          <img 
          loading="lazy"
            src="<%= listing.image %>" 
            class="card-img-top" 
            alt="<%= listing.title %>"
          >
            <div class="card-img-overlay"></div>

          <div class="card-body">
            <h4 class="card-title">
              <%= listing.title %>
            </h4>
<b>
<p class="price">
              &#8377; <%= listing.price.toLocaleString() %>-/night
            </p>
</b>
            
          </div>

        </div>

      </a>
    </div>

  <% }) %>

</main>