<% layout('layouts/boilerplate') -%>
<%- include('../includes/filters.ejs') %>
<main class="container-fluid">
  <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-3 g-4">

  <% allListings.forEach(listing => { %>
    <% const typeClass = listing.type === 'stay' ? 'bg-success' : 'bg-primary'; %>

    <div class="col">
      <a href="/listings/<%= listing.id %>" class="text-decoration-none">

        <div class="card h-100">

          <img 
          loading="lazy"
            src="<%= listing.image.url %>"
            class="card-img-top" 
            alt="<%= listing.title %>"
          >
            <div class="card-img-overlay"></div>

          <div class="card-body">
            <h4 class="card-title">
              <%= listing.title %>
    
            </h4>
<b>
<p class="price">
              &#8377; <%= listing.price.toLocaleString() %>-/night
            </p>
</b>
       <span class="badge <%= typeClass %>"><%= listing.type %></span> 
          </div>

        </div>

      </a>
    </div>

  <% }) %>

  </div>
</main>