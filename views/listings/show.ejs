<% layout('layouts/boilerplate') -%>

<div class="container mt-4 mb-5">
    <!-- 1. Your Original Listing Card (Kept completely intact) -->
    <div class="d-flex justify-content-center show-listing-container">
        <div class="card show-card" style="width: 18rem">
            <div class="card-body mt-0 p-0 "> <h1 class="card-title"><%= listing.title %></h1></div>
            <img
            loading="lazy"
                src="<%= listing.image.url %>"
                class="card-img-top show-img"
                alt="<%= listing.title %>" />
 <%  if (currentUser && listing.owner._id.equals(currentUser._id)) { %>
 
            <div class="card-body d-sm-flex gap-3">
                <a
                    href="/listings/<%= listing._id %>/edit"
                    class="card-link btn btn-primary mb-3"
                    role="button"
                    >Edit this Listing</a
                >
                <form
                    method="POST"
                    action="/listings/<%=listing._id%>?_method=DELETE">
                    <button class="card-link btn btn-danger">
                        Delete this listing
                    </button>
                </form>
            </div>

<% } else { %>

     <div class="card-body">
         <h3 class="card-text">@<%= listing.owner.username %></h3>
         <% listing.tags.forEach(tag => { %>
          <span class="badge text-bg-info"> <%= tag %> </span>
         <% }) %>
     </div>

    <% } %>
            <div class="card-body">
                <p class="card-text"><%= listing.description %></p>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item"><%= listing.country %></li>
                <li class="list-group-item"><%= listing.location %></li>
                <li class="list-group-item" style="color: #ff385c">
                    ₹ <%= listing.price.toLocaleString("en-IN") %>
                </li>
            </ul>

        </div>
    </div>

    <hr class="my-5"/>

    <!-- 2. Combined Review Submission & Display System -->
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            
            <!-- Dynamic Average Rating Header Calculation -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="mb-0">User Reviews</h4>
                <% if (listing.reviews && listing.reviews.length > 0) { 
                    let sum = listing.reviews.reduce((acc, rev) => acc + rev.stars, 0);
                    let avg = (sum / listing.reviews.length).toFixed(1);
                %>
                    <span class="badge bg-warning text-dark fs-6 p-2">
                        ★ <%= avg %> / 5.0 | <span class="bg-body-secondary border" ><%= listing.reviews.length %> : Reviews</span> 
                    </span>
                <% } else { %>
                    <span class="badge bg-light text-muted border p-2">No ratings yet</span>
                <% } %>
            </div>

        <!-- Leave a New Review -->


        <% if(currentUser && !currentUser._id.equals(listing.owner._id)){ %>
<div class="card p-4 mb-4 shadow-sm border-0 bg-light">

<h5 class="mb-3 card-title text-secondary">Leave a Review</h5>

<form
    class="needs-validation"
    novalidate
    action="/listings/<%= listing._id %>/review"
    method="POST">

    <!-- Star Rating Range Selector Slider -->

    <div class="mb-3">

        <label
            for="stars"
            class="form-label fw-semibold text-muted small">
            Rating
        </label>

        <input
            type="range"
            class="form-range"
            min="1"
            max="5"
            id="stars"
            name="stars"
            value="3"
            step="0.5"
            required>

        <div class="d-flex justify-content-between text-muted xsmall px-1">
            <span>1★</span>
            <span>2★</span>
            <span>3★</span>
            <span>4★</span>
            <span>5★</span>
        </div>

    </div>

    <!-- Comments Text Area -->

    <div class="mb-3">

        <label
            for="content"
            class="form-label fw-semibold text-muted small">
            Comments
        </label>

        <textarea
            class="form-control form-control-sm"
            style="
                height: 200px;
                max-height: 300px;
                min-height: 100px;
            "
            id="content"
            name="content"
            rows="3"
            minlength="10"
            maxlength="200"
            placeholder="Tell us about your experience (minimum 10 characters)..."
            required></textarea>

        <div class="invalid-feedback">
            Review must be between 10 and 200 characters.
        </div>

        <div class="valid-feedback">
            Nice! Review ✓
        </div>

    </div>

    <button
        type="submit"
        class="btn btn-sm btn-dark w-100 py-2 shadow-sm">
        Submit Review
    </button>

</form>


</div>
<% } %>
<script>
    (() => {
        "use strict";

        const forms = document.querySelectorAll(".needs-validation");

        Array.from(forms).forEach((form) => {
            form.addEventListener("submit", (event) => {

                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }

                form.classList.add("was-validated");
            });
        });
    })();
</script>


            <!-- List Display Grid for Existing Reviews -->
            <% if (listing.reviews && listing.reviews.length > 0) { %>
                <div class="d-flex flex-column gap-3">
                    <% for (let review of listing.reviews) { %>
                        <div class="card shadow-sm border-0 position-relative">
                            <div class="card-body p-3">
                                
                                
                                <div class="d-flex align-items-center mb-2">
                                    <img 
                                        src="<%= review.owner.avatar || 'https://cdn.jsdelivr.net/gh/faker-js/assets-person-portrait/male/512/52.jpg'%>" 
                                        alt="@<%= review.owner.username %>" 
                                        class="rounded-circle me-2 border border-2" 
                                        style="width: 36px; height: 36px; object-fit: cover;" />
                                    <h6 class="card-subtitle mb-0 text-dark fw-bold small">@<%= review.owner.username %></h6>
                                </div>
                                
                                <!-- Star Display Representation Row -->
                                <div class="text-warning small mb-2">
                                    <!-- 1. Display Full Stars -->
                                    <% for(let i = 1; i <= Math.floor(review.stars); i++) { %>★<% } %>
                                    
                                    <!-- 2. Display Half Star (if fractional part is >= 0.5) -->
                                    <% if (review.stars % 1 >= 0.5) { %>½<% } %>
                                    
                                    <!-- 3. Display Empty Stars -->
                                    <% for(let i = 1; i <= (5 - Math.ceil(review.stars)); i++) { %>☆<% } %>
                                </div>

                                
                                <!-- Content Message Body Box -->
                                <p class="card-text text-secondary small mb-3">"<%= review.content %>"</p>
                                
                                <!-- Action Management Control Row (Edit & Delete Buttons) -->
                                <% if(currentUser && review.owner && review.owner._id.equals(currentUser._id)){ %>
                                <div class="d-flex gap-2 border-top pt-2 justify-content-end">
                                    <!-- Edit Trigger Button (Routes to your review put method placeholder) -->
                                    <a 
                                        href="/listings/<%= listing._id %>/review/<%= review._id %>/edit" 
                                        class="btn btn-sm btn-link text-decoration-none text-muted py-0 px-2 small">
                                        Edit
                                    </a>
                                    
                                    <!-- Delete Inline Method-Override Form Link Execution -->
                                    <form 
                                        method="POST" 
                                        action="/listings/<%= listing._id %>/review/<%= review._id %>?_method=DELETE"
                                        class="m-0">
                                        <button class="btn btn-sm btn-link text-decoration-none text-danger py-0 px-2 small border-0 bg-transparent">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                                <% } %>

                            </div>
                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <div class="alert alert-light border text-center py-4 text-muted small shadow-sm" role="alert">
                    No reviews yet. Be the first to add your perspective!
                </div>
            <% } %>

        </div>
    </div>
</div>
