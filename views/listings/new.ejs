<% layout('layouts/boilerplate') -%>

<div class="col-8 offset-2 min-vh-100 form-container">
    <form
        method="post"
        action="/listings"
        enctype="multipart/form-data"
        class="needs-validation"
        novalidate>
        <!-- Title -->
        <div class="mb-3">
            <label for="title" class="form-label">Title:</label>
            <input
                minlength="3"
                placeholder="Enter title"
                name="listing[title]"
                type="text"
                class="form-control"
                id="title"
                required />

            <div class="valid-feedback">Looks good!</div>

            <div class="invalid-feedback">Please provide a title.</div>
        </div>

        <!-- Description -->
        <div class="mb-3">
            <label for="description" class="form-label"> Description: </label>

            <textarea
                minlength="20"
                placeholder="Enter description"
                name="listing[description]"
                class="form-control"
                id="description"
                required></textarea>

            <div class="invalid-feedback">Please provide a description.</div>
            <div class="valid-feedback">looks nice !</div>
        </div>

        <!-- Price -->
        <div class="mb-3">
            <label for="price" class="form-label">Price:</label>

            <input
                name="listing[price]"
                type="number"
                placeholder="Price ex: 1200"
                class="form-control"
                id="price"
                required />

            <div class="invalid-feedback">Please provide a valid price.</div>
        </div>

        <!-- Image -->
        <div class="mb-3">
            <label for="image" class="form-label">Image:</label>

            <input
                name="listing[imageFile]"
                type="file"
                accept=".jpg,.jpeg,.png,image/jpeg,image/png"
                class="form-control"
                id="image"
                required />
            <div class="invalid-feedback">
                Please select a JPG, JPEG, or PNG image.
            </div>
        </div>
        <div>
            <p class="form-label">Type :</p>
            <div class="alert alert-warning" role="alert">
                cant be changed after listing is saved
            </div>

            <!-- Experience Radio -->
            <div class="form-check mb-2">
                <input
                    class="form-check-input"
                    type="radio"
                    name="listing[type]"
                    id="experience"
                    value="experience"
                    required />
                <label class="form-check-label" for="experience">
                    Experience
                </label>
            </div>

            <!-- Stay Radio (Default Checked) -->
            <div class="form-check mb-3">
                <input
                    class="form-check-input"
                    type="radio"
                    name="listing[type]"
                    id="stay"
                    value="stay"
                    checked
                    required />
                <label class="form-check-label" for="stay"> Stay </label>

                <!-- Bootstrap feedback elements -->
                <div class="invalid-feedback">
                    Please select a listing type.
                </div>
                <div class="valid-feedback">Looks good!</div>
            </div>
        </div>

        <div class="row">
            <!-- Country -->
            <div class="col-md-4 mb-3">
                <label for="country" class="form-label">Country:</label>

                <input
                    placeholder="Enter country"
                    name="listing[country]"
                    type="text"
                    class="form-control"
                    id="country"
                    required />

                <div class="invalid-feedback">Please provide a country.</div>
            </div>

            <!-- Location -->
            <div class="col-md-8 mb-3">
                <label for="location" class="form-label">Location:</label>

                <input
                    placeholder="Enter location"
                    name="listing[location]"
                    type="text"
                    class="form-control"
                    id="location"
                    required />

                <div class="invalid-feedback">Please provide a location.</div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Submit</button>
    </form>
</div>

<script src="/js/new.js"></script>
